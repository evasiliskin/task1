{
  "name": "task1",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-service workspace: Angular front-end + NestJS microservices back-end",
  "scripts": {
    "dev:api-gateway": "pnpm --filter api-gateway run start:dev",
    "dev:service-b": "pnpm --filter service-b run start:dev",
    "dev:service-a": "pnpm --filter service-a run start:dev",
    "dev:front-end": "pnpm --filter front-end run start",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "engines": {
    "node": "26.5.0"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2"
  }
}
