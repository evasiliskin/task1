PORT=3000

# Serves the Swagger UI at /api-docs. Defaults to true outside production and false in
# production; only the exact string "true" enables it. The docker-compose stack sets it to
# true so the documented API is reachable there.
SWAGGER_ENABLED=true

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_SERVICE_B_QUEUE=service_b_queue
RABBITMQ_SERVICE_A_QUEUE=service_a_queue
RABBITMQ_SERVICE_A_IMPORTS_QUEUE=service_a_imports_queue
RABBITMQ_RPC_TIMEOUT_MS=10000

LOG_LEVEL=trace
APP_LOG_TRANSPORT=pretty

REDIS_URL=redis://localhost:6379
REDIS_PING_TIMEOUT_MS=3000

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_UPLOAD_LIMIT=5

STORAGE_DIR=./data/archives
UPLOAD_MAX_FILE_SIZE_BYTES=536870912
UPLOAD_RETENTION_MS=86400000
UPLOAD_SWEEP_INTERVAL_MS=900000
# Must be an absolute path shared with service-b (e.g. via a bind mount or
# Docker volume) when running outside docker-compose — the relative default
# below resolves against each process's own working directory and will not
# point at the same location for both services.
REPORT_DIR=./data/reports
