RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=service_b_queue
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MAX_RETRIES=5
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_RETRY_DELAY_MS=600000
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=10000

MONGODB_URI=mongodb://localhost:27017/service_b
HEALTH_PING_TIMEOUT_MS=3000
PROCESSING_LOG_RETENTION_MS=2592000000
# Must be an absolute path shared with api-gateway (e.g. via a bind mount or
# Docker volume) when running outside docker-compose — the relative default
# below resolves against each process's own working directory and will not
# point at the same location for both services.
REPORT_DIR=./data/reports
# Must comfortably exceed RABBITMQ_RPC_TIMEOUT_MS so a report in flight is
# never swept out from under an active download.
REPORT_RETENTION_MS=3600000
REPORT_SWEEP_INTERVAL_MS=600000

REDIS_URL=redis://localhost:6379

LOG_LEVEL=trace
APP_LOG_TRANSPORT=pretty
